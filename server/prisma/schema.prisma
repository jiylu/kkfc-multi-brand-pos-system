// Source: docs/multi_brand_pos.dbml.
// Field length policy: docs/schema-limits.md.
// Independent UUID primary keys are generated by Prisma with @default(uuid()).
// Shared primary/foreign keys and composite keys reuse the referenced IDs.
// modified_at defaults initialize values; updates remain explicit (no @updatedAt).
// Stock ledgers, lot caches and balances must update atomically in the backend.
// Modifier/menu pairing and cross-table business rules remain backend validations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED

  @@map("audit_outcomes")
}

enum ModifierComponentAction {
  ADD
  REMOVE

  @@map("modifier_component_actions")
}

enum KitchenTicketStatus {
  QUEUED
  ACKNOWLEDGED
  PREPARING
  CHECKING
  REWORKING
  READY
  HANDED_OVER
  CANCELLED

  @@map("kitchen_ticket_statuses")
}

enum KitchenEventType {
  CREATED
  ACKNOWLEDGED
  PREPARATION_STARTED
  SUBMITTED_FOR_QC
  QC_FAILED
  REWORK_STARTED
  QC_PASSED
  READY
  HANDED_OVER
  CANCELLED
  ASSIGNMENT_CHANGED

  @@map("kitchen_event_types")
}

enum OrderEventType {
  CREATED
  CONFIRMED
  ITEM_ADDED
  ITEM_UPDATED
  ITEM_REMOVED
  MODIFIER_CHANGED
  STATUS_CHANGED
  CANCELLED

  @@map("order_event_types")
}

enum OrderChannel {
  DINE_IN
  TAKEAWAY
  GRABFOOD
  FOODPANDA

  @@map("order_channels")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PREPARING
  REWORKING
  CHECKING
  READY
  COMPLETED
  CANCELLED

  @@map("order_statuses")
}

enum UserRole {
  ORDER_STAFF
  KITCHEN_PREPARER
  RECEIVING_STAFF
  KITCHEN_HEAD
  OWNER

  @@map("user_roles")
}

enum StockBucket {
  USABLE
  HELD
  IN_PREPARATION

  @@map("stock_buckets")
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED

  @@map("reservation_statuses")
}

enum RecipeType {
  MENU_ASSEMBLY
  PRODUCTION

  @@map("recipe_types")
}

enum InventoryType {
  RAW
  PREPPED
  PACKAGING

  @@map("inventory_types")
}

enum ReceiptStatus {
  DRAFT
  ACCEPTED
  CANCELLED

  @@map("receipt_statuses")
}

enum CountStatus {
  DRAFT
  SUBMITTED
  REVIEWED

  @@map("count_statuses")
}

enum AdjustmentStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED

  @@map("adjustment_statuses")
}

enum StockMovementType {
  RECEIPT
  BUCKET_TRANSFER
  ORDER_CONSUMPTION
  PRODUCTION_ISSUE
  PRODUCTION_OUTPUT
  PRODUCTION_RETURN
  WASTE
  ADJUSTMENT
  REVERSAL

  @@map("stock_movement_types")
}

enum ProductionStatus {
  DRAFT
  APPROVED
  IN_PROGRESS
  AWAITING_QC
  HELD
  REWORKING
  ACCEPTED
  REJECTED
  CANCELLED

  @@map("production_statuses")
}

enum ProductionEventType {
  APPROVED
  STARTED
  SUBMITTED_FOR_QC
  QC_PASSED
  QC_FAILED
  HELD
  REWORK_STARTED
  ACCEPTED
  REJECTED
  CANCELLED

  @@map("production_event_types")
}

model User {
  user_id       String   @id @default(uuid()) @db.Uuid
  first_name    String   @db.VarChar(100)
  last_name     String   @db.VarChar(100)
  password_hash String   @db.VarChar(255)
  role          UserRole
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  modified_at   DateTime @default(now()) @db.Timestamp(6)

  user_brand_assignments_user          UserBrandAssignment[]   @relation("UserBrandAssignmentUser")
  orders_created_by                    Order[]                 @relation("OrderCreatedBy")
  orders_cancelled_by                  Order[]                 @relation("OrderCancelledBy")
  goods_receipts_created_by            GoodsReceipt[]          @relation("GoodsReceiptCreatedBy")
  goods_receipts_accepted_by           GoodsReceipt[]          @relation("GoodsReceiptAcceptedBy")
  stock_reservations_created_by        StockReservation[]      @relation("StockReservationCreatedBy")
  stock_counts_created_by              StockCount[]            @relation("StockCountCreatedBy")
  stock_counts_reviewed_by             StockCount[]            @relation("StockCountReviewedBy")
  stock_count_items_counted_by         StockCountItem[]        @relation("StockCountItemCountedBy")
  stock_adjustments_requested_by       StockAdjustment[]       @relation("StockAdjustmentRequestedBy")
  stock_adjustments_reviewed_by        StockAdjustment[]       @relation("StockAdjustmentReviewedBy")
  stock_movements_created_by           StockMovement[]         @relation("StockMovementCreatedBy")
  production_batches_created_by        ProductionBatch[]       @relation("ProductionBatchCreatedBy")
  production_batches_preparer          ProductionBatch[]       @relation("ProductionBatchPreparer")
  production_batches_checker           ProductionBatch[]       @relation("ProductionBatchChecker")
  production_batches_approved_by       ProductionBatch[]       @relation("ProductionBatchApprovedBy")
  production_batch_inputs_issued_by    ProductionBatchInput[]  @relation("ProductionBatchInputIssuedBy")
  production_batch_outputs_recorded_by ProductionBatchOutput[] @relation("ProductionBatchOutputRecordedBy")
  production_batch_outputs_accepted_by ProductionBatchOutput[] @relation("ProductionBatchOutputAcceptedBy")
  production_batch_returns_returned_by ProductionBatchReturn[] @relation("ProductionBatchReturnReturnedBy")
  production_batch_losses_recorded_by  ProductionBatchLoss[]   @relation("ProductionBatchLossRecordedBy")
  production_batch_events_performed_by ProductionBatchEvent[]  @relation("ProductionBatchEventPerformedBy")
  kitchen_tickets_preparer             KitchenTicket[]         @relation("KitchenTicketPreparer")
  kitchen_tickets_checker              KitchenTicket[]         @relation("KitchenTicketChecker")
  kitchen_tickets_created_by           KitchenTicket[]         @relation("KitchenTicketCreatedBy")
  kitchen_ticket_events_performed_by   KitchenTicketEvent[]    @relation("KitchenTicketEventPerformedBy")
  order_events_performed_by            OrderEvent[]            @relation("OrderEventPerformedBy")
  audit_logs_actor                     AuditLog[]              @relation("AuditLogActor")

  @@map("users")
}

model UserBrandAssignment {
  user_id     String   @db.Uuid
  brand_id    String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamp(6)
  modified_at DateTime @default(now()) @db.Timestamp(6)

  user  User  @relation("UserBrandAssignmentUser", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  brand Brand @relation("UserBrandAssignmentBrand", fields: [brand_id], references: [brand_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, brand_id])
  @@map("user_brand_assignments")
}

model Brand {
  brand_id    String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  logo_url    String?  @db.VarChar(2048)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  modified_at DateTime @default(now()) @db.Timestamp(6)
  is_active   Boolean  @default(true)

  user_brand_assignments_brand UserBrandAssignment[] @relation("UserBrandAssignmentBrand")
  orders_brand                 Order[]               @relation("OrderBrand")
  menu_items_brand             MenuItem[]            @relation("MenuItemBrand")

  @@map("brands")
}

model Order {
  order_id                 String       @id @default(uuid()) @db.Uuid
  brand_id                 String       @db.Uuid
  created_by_id            String       @db.Uuid
  order_channel            OrderChannel
  /// Stable platform store ID or configured store code; null for internal orders
  merchant_store_reference String?      @db.VarChar(255)
  /// Platform order ID; null for internal orders
  external_order_reference String?      @db.VarChar(255)
  table_reference          String?      @db.VarChar(50)
  status                   OrderStatus  @default(DRAFT)
  notes                    String?      @db.VarChar(2000)
  cancelled_by_id          String?      @db.Uuid
  cancellation_reason      String?      @db.VarChar(1000)
  cancelled_at             DateTime?    @db.Timestamp(6)
  confirmed_at             DateTime?    @db.Timestamp(6)
  completed_at             DateTime?    @db.Timestamp(6)
  created_at               DateTime     @default(now()) @db.Timestamp(6)
  modified_at              DateTime     @default(now()) @db.Timestamp(6)

  brand                 Brand          @relation("OrderBrand", fields: [brand_id], references: [brand_id], onDelete: NoAction, onUpdate: NoAction)
  created_by            User           @relation("OrderCreatedBy", fields: [created_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  cancelled_by          User?          @relation("OrderCancelledBy", fields: [cancelled_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  order_items_order     OrderItem[]    @relation("OrderItemOrder")
  kitchen_tickets_order KitchenTicket? @relation("KitchenTicketOrder")
  order_events_order    OrderEvent[]   @relation("OrderEventOrder")

  @@unique([order_channel, merchant_store_reference, external_order_reference])
  @@index([brand_id, created_at])
  @@map("orders")
}

model OrderItem {
  order_item_id String  @id @default(uuid()) @db.Uuid
  order_id      String  @db.Uuid
  menu_item_id  String  @db.Uuid
  item_name     String  @db.VarChar(150)
  quantity      Int
  unit_price    Decimal @db.Decimal(12, 2)
  notes         String? @db.VarChar(2000)

  order                           Order               @relation("OrderItemOrder", fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)
  menu_item                       MenuItem            @relation("OrderItemMenuItem", fields: [menu_item_id], references: [menu_item_id], onDelete: NoAction, onUpdate: NoAction)
  order_item_modifiers_order_item OrderItemModifier[] @relation("OrderItemModifierOrderItem")
  stock_reservations_order_item   StockReservation[]  @relation("StockReservationOrderItem")
  stock_movements_order_item      StockMovement[]     @relation("StockMovementOrderItem")

  @@map("order_items")
}

model OrderItemModifier {
  order_item_modifier_id String  @id @default(uuid()) @db.Uuid
  order_item_id          String  @db.Uuid
  modifier_id            String  @db.Uuid
  modifier_name          String  @db.VarChar(150)
  additional_price       Decimal @default(0) @db.Decimal(12, 2)

  order_item OrderItem @relation("OrderItemModifierOrderItem", fields: [order_item_id], references: [order_item_id], onDelete: NoAction, onUpdate: NoAction)
  modifier   Modifier  @relation("OrderItemModifierModifier", fields: [modifier_id], references: [modifier_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([order_item_id, modifier_id])
  @@map("order_item_modifiers")
}

model MenuItem {
  menu_item_id        String   @id @default(uuid()) @db.Uuid
  brand_id            String   @db.Uuid
  recipe_id           String?  @db.Uuid
  code                String   @unique @db.VarChar(64)
  name                String   @db.VarChar(150)
  description         String?  @db.VarChar(2000)
  serving_description String?  @db.VarChar(255)
  base_price          Decimal  @db.Decimal(12, 2)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now()) @db.Timestamp(6)
  modified_at         DateTime @default(now()) @db.Timestamp(6)

  brand                         Brand               @relation("MenuItemBrand", fields: [brand_id], references: [brand_id], onDelete: NoAction, onUpdate: NoAction)
  recipe                        Recipe?             @relation("MenuItemRecipe", fields: [recipe_id], references: [recipe_id], onDelete: NoAction, onUpdate: NoAction)
  order_items_menu_item         OrderItem[]         @relation("OrderItemMenuItem")
  menu_item_modifiers_menu_item MenuItemModifier[]  @relation("MenuItemModifierMenuItem")
  modifier_components_menu_item ModifierComponent[] @relation("ModifierComponentMenuItem")

  @@map("menu_items")
}

model Modifier {
  modifier_id String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(2000)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  modified_at DateTime @default(now()) @db.Timestamp(6)

  order_item_modifiers_modifier OrderItemModifier[] @relation("OrderItemModifierModifier")
  menu_item_modifiers_modifier  MenuItemModifier[]  @relation("MenuItemModifierModifier")
  modifier_components_modifier  ModifierComponent[] @relation("ModifierComponentModifier")

  @@map("modifiers")
}

model MenuItemModifier {
  menu_item_id     String  @db.Uuid
  modifier_id      String  @db.Uuid
  additional_price Decimal @default(0) @db.Decimal(12, 2)

  menu_item MenuItem @relation("MenuItemModifierMenuItem", fields: [menu_item_id], references: [menu_item_id], onDelete: NoAction, onUpdate: NoAction)
  modifier  Modifier @relation("MenuItemModifierModifier", fields: [modifier_id], references: [modifier_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([menu_item_id, modifier_id])
  @@map("menu_item_modifiers")
}

model ModifierComponent {
  modifier_component_id String                  @id @default(uuid()) @db.Uuid
  menu_item_id          String                  @db.Uuid
  modifier_id           String                  @db.Uuid
  inventory_item_id     String                  @db.Uuid
  action                ModifierComponentAction
  /// Positive quantity per menu serving, in the inventory item base unit
  quantity              Decimal                 @db.Decimal(14, 3)

  menu_item      MenuItem      @relation("ModifierComponentMenuItem", fields: [menu_item_id], references: [menu_item_id], onDelete: NoAction, onUpdate: NoAction)
  modifier       Modifier      @relation("ModifierComponentModifier", fields: [modifier_id], references: [modifier_id], onDelete: NoAction, onUpdate: NoAction)
  inventory_item InventoryItem @relation("ModifierComponentInventoryItem", fields: [inventory_item_id], references: [inventory_item_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([menu_item_id, modifier_id, inventory_item_id, action])
  @@map("modifier_components")
}

model InventoryItem {
  inventory_item_id String        @id @default(uuid()) @db.Uuid
  code              String        @unique @db.VarChar(64)
  name              String        @db.VarChar(150)
  type              InventoryType
  /// g, ml, pc
  base_unit         String        @db.VarChar(16)
  is_active         Boolean       @default(true)
  created_at        DateTime      @default(now()) @db.Timestamp(6)
  modified_at       DateTime      @default(now()) @db.Timestamp(6)

  modifier_components_inventory_item ModifierComponent[] @relation("ModifierComponentInventoryItem")
  stock_balances_inventory_item      StockBalance?       @relation("StockBalanceInventoryItem")
  goods_receipt_items_inventory_item GoodsReceiptItem[]  @relation("GoodsReceiptItemInventoryItem")
  stock_lots_inventory_item          StockLot[]          @relation("StockLotInventoryItem")
  recipes_output_inventory_item      Recipe[]            @relation("RecipeOutputInventoryItem")
  recipe_components_inventory_item   RecipeComponent[]   @relation("RecipeComponentInventoryItem")

  @@map("inventory_items")
}

/// Cached item totals across lots. On-hand includes usable, held and in-preparation quantities. Reserved stock is a subset of usable stock.
model StockBalance {
  inventory_item_id       String   @id @db.Uuid
  quantity_on_hand        Decimal  @default(0) @db.Decimal(14, 3)
  quantity_held           Decimal  @default(0) @db.Decimal(14, 3)
  quantity_in_preparation Decimal  @default(0) @db.Decimal(14, 3)
  quantity_reserved       Decimal  @default(0) @db.Decimal(14, 3)
  modified_at             DateTime @default(now()) @db.Timestamp(6)

  inventory_item InventoryItem @relation("StockBalanceInventoryItem", fields: [inventory_item_id], references: [inventory_item_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("stock_balances")
}

model GoodsReceipt {
  goods_receipt_id            String        @id @default(uuid()) @db.Uuid
  receipt_number              String        @unique @db.VarChar(64)
  supplier_name               String        @db.VarChar(200)
  supplier_document_reference String?       @db.VarChar(255)
  status                      ReceiptStatus @default(DRAFT)
  received_at                 DateTime      @db.Timestamp(6)
  created_by_id               String        @db.Uuid
  accepted_by_id              String?       @db.Uuid
  accepted_at                 DateTime?     @db.Timestamp(6)
  notes                       String?       @db.VarChar(2000)
  created_at                  DateTime      @default(now()) @db.Timestamp(6)
  modified_at                 DateTime      @default(now()) @db.Timestamp(6)

  created_by                        User               @relation("GoodsReceiptCreatedBy", fields: [created_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  accepted_by                       User?              @relation("GoodsReceiptAcceptedBy", fields: [accepted_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  goods_receipt_items_goods_receipt GoodsReceiptItem[] @relation("GoodsReceiptItemGoodsReceipt")

  @@map("goods_receipts")
}

/// Use separate lines for different supplier batches or expiry dates, even for the same inventory item.
model GoodsReceiptItem {
  goods_receipt_item_id    String    @id @default(uuid()) @db.Uuid
  goods_receipt_id         String    @db.Uuid
  inventory_item_id        String    @db.Uuid
  supplier_batch_reference String?   @db.VarChar(255)
  use_by_at                DateTime? @db.Timestamp(6)
  delivered_quantity       Decimal   @db.Decimal(14, 3)
  accepted_quantity        Decimal   @default(0) @db.Decimal(14, 3)
  rejected_quantity        Decimal   @default(0) @db.Decimal(14, 3)
  rejection_reason         String?   @db.VarChar(1000)
  notes                    String?   @db.VarChar(2000)

  goods_receipt                      GoodsReceipt    @relation("GoodsReceiptItemGoodsReceipt", fields: [goods_receipt_id], references: [goods_receipt_id], onDelete: NoAction, onUpdate: NoAction)
  inventory_item                     InventoryItem   @relation("GoodsReceiptItemInventoryItem", fields: [inventory_item_id], references: [inventory_item_id], onDelete: NoAction, onUpdate: NoAction)
  stock_lots_goods_receipt_item      StockLot[]      @relation("StockLotGoodsReceiptItem")
  stock_movements_goods_receipt_item StockMovement[] @relation("StockMovementGoodsReceiptItem")

  @@map("goods_receipt_items")
}

/// Batch-level quantity caches. Reserved quantity is included within usable quantity. Expired lots are excluded from availability.
model StockLot {
  stock_lot_id            String    @id @default(uuid()) @db.Uuid
  inventory_item_id       String    @db.Uuid
  lot_code                String    @unique @db.VarChar(64)
  goods_receipt_item_id   String?   @db.Uuid
  prepared_at             DateTime? @db.Timestamp(6)
  use_by_at               DateTime? @db.Timestamp(6)
  quantity_usable         Decimal   @default(0) @db.Decimal(14, 3)
  quantity_held           Decimal   @default(0) @db.Decimal(14, 3)
  quantity_in_preparation Decimal   @default(0) @db.Decimal(14, 3)
  quantity_reserved       Decimal   @default(0) @db.Decimal(14, 3)
  created_at              DateTime  @default(now()) @db.Timestamp(6)
  modified_at             DateTime  @default(now()) @db.Timestamp(6)

  inventory_item                     InventoryItem          @relation("StockLotInventoryItem", fields: [inventory_item_id], references: [inventory_item_id], onDelete: NoAction, onUpdate: NoAction)
  goods_receipt_item                 GoodsReceiptItem?      @relation("StockLotGoodsReceiptItem", fields: [goods_receipt_item_id], references: [goods_receipt_item_id], onDelete: NoAction, onUpdate: NoAction)
  stock_reservations_stock_lot       StockReservation[]     @relation("StockReservationStockLot")
  stock_count_items_stock_lot        StockCountItem[]       @relation("StockCountItemStockLot")
  stock_adjustment_items_stock_lot   StockAdjustmentItem[]  @relation("StockAdjustmentItemStockLot")
  stock_movements_stock_lot          StockMovement[]        @relation("StockMovementStockLot")
  production_batch_inputs_stock_lot  ProductionBatchInput[] @relation("ProductionBatchInputStockLot")
  production_batch_outputs_stock_lot ProductionBatchOutput? @relation("ProductionBatchOutputStockLot")

  @@index([inventory_item_id, use_by_at])
  @@map("stock_lots")
}

/// One allocation per row. Reserving reduces availability without reducing physical stock.
model StockReservation {
  stock_reservation_id String            @id @default(uuid()) @db.Uuid
  stock_lot_id         String            @db.Uuid
  order_item_id        String            @db.Uuid
  quantity             Decimal           @db.Decimal(14, 3)
  status               ReservationStatus @default(ACTIVE)
  reservation_key      String            @unique @db.VarChar(255)
  created_by_id        String            @db.Uuid
  created_at           DateTime          @default(now()) @db.Timestamp(6)
  consumed_at          DateTime?         @db.Timestamp(6)
  released_at          DateTime?         @db.Timestamp(6)

  stock_lot                         StockLot        @relation("StockReservationStockLot", fields: [stock_lot_id], references: [stock_lot_id], onDelete: NoAction, onUpdate: NoAction)
  order_item                        OrderItem       @relation("StockReservationOrderItem", fields: [order_item_id], references: [order_item_id], onDelete: NoAction, onUpdate: NoAction)
  created_by                        User            @relation("StockReservationCreatedBy", fields: [created_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  stock_movements_stock_reservation StockMovement[] @relation("StockMovementStockReservation")

  @@index([order_item_id, status])
  @@index([stock_lot_id, status])
  @@map("stock_reservations")
}

model StockCount {
  stock_count_id String      @id @default(uuid()) @db.Uuid
  status         CountStatus @default(DRAFT)
  cutoff_at      DateTime    @db.Timestamp(6)
  created_by_id  String      @db.Uuid
  reviewed_by_id String?     @db.Uuid
  submitted_at   DateTime?   @db.Timestamp(6)
  reviewed_at    DateTime?   @db.Timestamp(6)
  notes          String?     @db.VarChar(2000)
  created_at     DateTime    @default(now()) @db.Timestamp(6)
  modified_at    DateTime    @default(now()) @db.Timestamp(6)

  created_by                    User              @relation("StockCountCreatedBy", fields: [created_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  reviewed_by                   User?             @relation("StockCountReviewedBy", fields: [reviewed_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  stock_count_items_stock_count StockCountItem[]  @relation("StockCountItemStockCount")
  stock_adjustments_stock_count StockAdjustment[] @relation("StockAdjustmentStockCount")

  @@map("stock_counts")
}

/// Count by lot and stock bucket. Expected quantity is captured at the cutoff; counting does not post stock.
model StockCountItem {
  stock_count_item_id String      @id @default(uuid()) @db.Uuid
  stock_count_id      String      @db.Uuid
  stock_lot_id        String      @db.Uuid
  bucket              StockBucket
  expected_quantity   Decimal     @db.Decimal(14, 3)
  counted_quantity    Decimal     @db.Decimal(14, 3)
  counted_by_id       String      @db.Uuid
  counted_at          DateTime    @db.Timestamp(6)
  notes               String?     @db.VarChar(2000)

  stock_count StockCount @relation("StockCountItemStockCount", fields: [stock_count_id], references: [stock_count_id], onDelete: NoAction, onUpdate: NoAction)
  stock_lot   StockLot   @relation("StockCountItemStockLot", fields: [stock_lot_id], references: [stock_lot_id], onDelete: NoAction, onUpdate: NoAction)
  counted_by  User       @relation("StockCountItemCountedBy", fields: [counted_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([stock_count_id, stock_lot_id, bucket])
  @@map("stock_count_items")
}

model StockAdjustment {
  stock_adjustment_id String           @id @default(uuid()) @db.Uuid
  stock_count_id      String?          @db.Uuid
  status              AdjustmentStatus @default(DRAFT)
  reason_code         String           @db.VarChar(64)
  reason              String           @db.VarChar(1000)
  requested_by_id     String           @db.Uuid
  reviewed_by_id      String?          @db.Uuid
  reviewed_at         DateTime?        @db.Timestamp(6)
  review_notes        String?          @db.VarChar(2000)
  created_at          DateTime         @default(now()) @db.Timestamp(6)
  modified_at         DateTime         @default(now()) @db.Timestamp(6)

  stock_count                             StockCount?           @relation("StockAdjustmentStockCount", fields: [stock_count_id], references: [stock_count_id], onDelete: NoAction, onUpdate: NoAction)
  requested_by                            User                  @relation("StockAdjustmentRequestedBy", fields: [requested_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  reviewed_by                             User?                 @relation("StockAdjustmentReviewedBy", fields: [reviewed_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  stock_adjustment_items_stock_adjustment StockAdjustmentItem[] @relation("StockAdjustmentItemStockAdjustment")

  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  stock_adjustment_item_id String      @id @default(uuid()) @db.Uuid
  stock_adjustment_id      String      @db.Uuid
  stock_lot_id             String      @db.Uuid
  bucket                   StockBucket
  quantity_change          Decimal     @db.Decimal(14, 3)
  notes                    String?     @db.VarChar(2000)

  stock_adjustment                      StockAdjustment @relation("StockAdjustmentItemStockAdjustment", fields: [stock_adjustment_id], references: [stock_adjustment_id], onDelete: NoAction, onUpdate: NoAction)
  stock_lot                             StockLot        @relation("StockAdjustmentItemStockLot", fields: [stock_lot_id], references: [stock_lot_id], onDelete: NoAction, onUpdate: NoAction)
  stock_movements_stock_adjustment_item StockMovement[] @relation("StockMovementStockAdjustmentItem")

  @@unique([stock_adjustment_id, stock_lot_id, bucket])
  @@map("stock_adjustment_items")
}

/// Immutable ledger. Inventory item is identified through the stock lot.
model StockMovement {
  stock_movement_id          String            @id @default(uuid()) @db.Uuid
  stock_lot_id               String            @db.Uuid
  type                       StockMovementType
  bucket                     StockBucket
  /// Signed quantity in the inventory item base unit
  quantity_change            Decimal           @db.Decimal(14, 3)
  goods_receipt_item_id      String?           @db.Uuid
  stock_adjustment_item_id   String?           @db.Uuid
  order_item_id              String?           @db.Uuid
  stock_reservation_id       String?           @db.Uuid
  /// Groups paired movements between stock buckets
  transfer_key               String?           @db.VarChar(255)
  posting_key                String            @unique @db.VarChar(255)
  reverses_movement_id       String?           @db.Uuid
  created_by_id              String            @db.Uuid
  reason                     String?           @db.VarChar(1000)
  occurred_at                DateTime          @db.Timestamp(6)
  created_at                 DateTime          @default(now()) @db.Timestamp(6)
  production_batch_input_id  String?           @db.Uuid
  production_batch_output_id String?           @db.Uuid
  production_batch_return_id String?           @db.Uuid
  production_batch_loss_id   String?           @db.Uuid

  stock_lot                         StockLot               @relation("StockMovementStockLot", fields: [stock_lot_id], references: [stock_lot_id], onDelete: NoAction, onUpdate: NoAction)
  goods_receipt_item                GoodsReceiptItem?      @relation("StockMovementGoodsReceiptItem", fields: [goods_receipt_item_id], references: [goods_receipt_item_id], onDelete: NoAction, onUpdate: NoAction)
  stock_adjustment_item             StockAdjustmentItem?   @relation("StockMovementStockAdjustmentItem", fields: [stock_adjustment_item_id], references: [stock_adjustment_item_id], onDelete: NoAction, onUpdate: NoAction)
  order_item                        OrderItem?             @relation("StockMovementOrderItem", fields: [order_item_id], references: [order_item_id], onDelete: NoAction, onUpdate: NoAction)
  stock_reservation                 StockReservation?      @relation("StockMovementStockReservation", fields: [stock_reservation_id], references: [stock_reservation_id], onDelete: NoAction, onUpdate: NoAction)
  reverses_movement                 StockMovement?         @relation("StockMovementReversesMovement", fields: [reverses_movement_id], references: [stock_movement_id], onDelete: NoAction, onUpdate: NoAction)
  created_by                        User                   @relation("StockMovementCreatedBy", fields: [created_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  production_batch_input            ProductionBatchInput?  @relation("StockMovementProductionBatchInput", fields: [production_batch_input_id], references: [production_batch_input_id], onDelete: NoAction, onUpdate: NoAction)
  production_batch_output           ProductionBatchOutput? @relation("StockMovementProductionBatchOutput", fields: [production_batch_output_id], references: [production_batch_output_id], onDelete: NoAction, onUpdate: NoAction)
  production_batch_return           ProductionBatchReturn? @relation("StockMovementProductionBatchReturn", fields: [production_batch_return_id], references: [production_batch_return_id], onDelete: NoAction, onUpdate: NoAction)
  production_batch_loss             ProductionBatchLoss?   @relation("StockMovementProductionBatchLoss", fields: [production_batch_loss_id], references: [production_batch_loss_id], onDelete: NoAction, onUpdate: NoAction)
  stock_movements_reverses_movement StockMovement[]        @relation("StockMovementReversesMovement")

  @@index([stock_lot_id, bucket, occurred_at])
  @@index([transfer_key])
  @@map("stock_movements")
}

/// MENU_ASSEMBLY: components per serving. PRODUCTION: components per standard batch, with an output inventory item and expected yield.
model Recipe {
  recipe_id                String     @id @default(uuid()) @db.Uuid
  code                     String     @db.VarChar(64)
  name                     String     @db.VarChar(150)
  type                     RecipeType
  output_inventory_item_id String?    @db.Uuid
  expected_output_quantity Decimal?   @db.Decimal(14, 3)
  serving_description      String?    @db.VarChar(255)
  instructions             String?    @db.VarChar(10000)
  notes                    String?    @db.VarChar(2000)
  version                  Int        @default(1)
  is_active                Boolean    @default(true)
  created_at               DateTime   @default(now()) @db.Timestamp(6)
  modified_at              DateTime   @default(now()) @db.Timestamp(6)

  output_inventory_item     InventoryItem?    @relation("RecipeOutputInventoryItem", fields: [output_inventory_item_id], references: [inventory_item_id], onDelete: NoAction, onUpdate: NoAction)
  menu_items_recipe         MenuItem[]        @relation("MenuItemRecipe")
  recipe_components_recipe  RecipeComponent[] @relation("RecipeComponentRecipe")
  production_batches_recipe ProductionBatch[] @relation("ProductionBatchRecipe")

  @@unique([code, version])
  @@map("recipes")
}

/// Quantity uses the ingredient inventory item base unit. Ingredients may be raw or prepared items.
model RecipeComponent {
  recipe_component_id String  @id @default(uuid()) @db.Uuid
  recipe_id           String  @db.Uuid
  inventory_item_id   String  @db.Uuid
  quantity            Decimal @db.Decimal(14, 3)
  notes               String? @db.VarChar(2000)

  recipe         Recipe        @relation("RecipeComponentRecipe", fields: [recipe_id], references: [recipe_id], onDelete: NoAction, onUpdate: NoAction)
  inventory_item InventoryItem @relation("RecipeComponentInventoryItem", fields: [inventory_item_id], references: [inventory_item_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([recipe_id, inventory_item_id])
  @@map("recipe_components")
}

/// Recipe must be PRODUCTION. Target quantity uses the recipe output item base unit.
model ProductionBatch {
  production_batch_id    String           @id @default(uuid()) @db.Uuid
  batch_number           String           @unique @db.VarChar(64)
  recipe_id              String           @db.Uuid
  target_output_quantity Decimal          @db.Decimal(14, 3)
  status                 ProductionStatus @default(DRAFT)
  created_by_id          String           @db.Uuid
  preparer_id            String?          @db.Uuid
  checker_id             String?          @db.Uuid
  approved_by_id         String?          @db.Uuid
  approved_at            DateTime?        @db.Timestamp(6)
  scheduled_at           DateTime?        @db.Timestamp(6)
  started_at             DateTime?        @db.Timestamp(6)
  completed_at           DateTime?        @db.Timestamp(6)
  notes                  String?          @db.VarChar(2000)
  created_at             DateTime         @default(now()) @db.Timestamp(6)
  modified_at            DateTime         @default(now()) @db.Timestamp(6)

  recipe                                    Recipe                  @relation("ProductionBatchRecipe", fields: [recipe_id], references: [recipe_id], onDelete: NoAction, onUpdate: NoAction)
  created_by                                User                    @relation("ProductionBatchCreatedBy", fields: [created_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  preparer                                  User?                   @relation("ProductionBatchPreparer", fields: [preparer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  checker                                   User?                   @relation("ProductionBatchChecker", fields: [checker_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  approved_by                               User?                   @relation("ProductionBatchApprovedBy", fields: [approved_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  production_batch_inputs_production_batch  ProductionBatchInput[]  @relation("ProductionBatchInputProductionBatch")
  production_batch_outputs_production_batch ProductionBatchOutput[] @relation("ProductionBatchOutputProductionBatch")
  production_batch_losses_production_batch  ProductionBatchLoss[]   @relation("ProductionBatchLossProductionBatch")
  production_batch_events_production_batch  ProductionBatchEvent[]  @relation("ProductionBatchEventProductionBatch")

  @@map("production_batches")
}

/// One actual issue per row. The source lot identifies the input item and unit.
model ProductionBatchInput {
  production_batch_input_id String   @id @default(uuid()) @db.Uuid
  production_batch_id       String   @db.Uuid
  stock_lot_id              String   @db.Uuid
  issued_quantity           Decimal  @db.Decimal(14, 3)
  issued_by_id              String   @db.Uuid
  issued_at                 DateTime @db.Timestamp(6)
  notes                     String?  @db.VarChar(2000)

  production_batch                                ProductionBatch         @relation("ProductionBatchInputProductionBatch", fields: [production_batch_id], references: [production_batch_id], onDelete: NoAction, onUpdate: NoAction)
  stock_lot                                       StockLot                @relation("ProductionBatchInputStockLot", fields: [stock_lot_id], references: [stock_lot_id], onDelete: NoAction, onUpdate: NoAction)
  issued_by                                       User                    @relation("ProductionBatchInputIssuedBy", fields: [issued_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  stock_movements_production_batch_input          StockMovement[]         @relation("StockMovementProductionBatchInput")
  production_batch_returns_production_batch_input ProductionBatchReturn[] @relation("ProductionBatchReturnProductionBatchInput")
  production_batch_losses_production_batch_input  ProductionBatchLoss[]   @relation("ProductionBatchLossProductionBatchInput")

  @@map("production_batch_inputs")
}

/// Output initially enters HELD stock. Accepted quantities transfer to USABLE. Prepared time and use-by are stored on the output lot.
model ProductionBatchOutput {
  production_batch_output_id String    @id @default(uuid()) @db.Uuid
  production_batch_id        String    @db.Uuid
  stock_lot_id               String    @unique @db.Uuid
  produced_quantity          Decimal   @db.Decimal(14, 3)
  accepted_quantity          Decimal   @default(0) @db.Decimal(14, 3)
  recorded_by_id             String    @db.Uuid
  recorded_at                DateTime  @db.Timestamp(6)
  accepted_by_id             String?   @db.Uuid
  accepted_at                DateTime? @db.Timestamp(6)
  notes                      String?   @db.VarChar(2000)

  production_batch                                ProductionBatch       @relation("ProductionBatchOutputProductionBatch", fields: [production_batch_id], references: [production_batch_id], onDelete: NoAction, onUpdate: NoAction)
  stock_lot                                       StockLot              @relation("ProductionBatchOutputStockLot", fields: [stock_lot_id], references: [stock_lot_id], onDelete: NoAction, onUpdate: NoAction)
  recorded_by                                     User                  @relation("ProductionBatchOutputRecordedBy", fields: [recorded_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  accepted_by                                     User?                 @relation("ProductionBatchOutputAcceptedBy", fields: [accepted_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  stock_movements_production_batch_output         StockMovement[]       @relation("StockMovementProductionBatchOutput")
  production_batch_losses_production_batch_output ProductionBatchLoss[] @relation("ProductionBatchLossProductionBatchOutput")

  @@map("production_batch_outputs")
}

/// Recoverable unused input returns to its source lot. Transformed leftovers require a separate output item.
model ProductionBatchReturn {
  production_batch_return_id String   @id @default(uuid()) @db.Uuid
  production_batch_input_id  String   @db.Uuid
  quantity                   Decimal  @db.Decimal(14, 3)
  reason                     String   @db.VarChar(1000)
  returned_by_id             String   @db.Uuid
  returned_at                DateTime @db.Timestamp(6)

  production_batch_input                  ProductionBatchInput @relation("ProductionBatchReturnProductionBatchInput", fields: [production_batch_input_id], references: [production_batch_input_id], onDelete: NoAction, onUpdate: NoAction)
  returned_by                             User                 @relation("ProductionBatchReturnReturnedBy", fields: [returned_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  stock_movements_production_batch_return StockMovement[]      @relation("StockMovementProductionBatchReturn")

  @@map("production_batch_returns")
}

/// Reference exactly one input or output belonging to this batch. Quantity uses that item base unit.
model ProductionBatchLoss {
  production_batch_loss_id   String   @id @default(uuid()) @db.Uuid
  production_batch_id        String   @db.Uuid
  production_batch_input_id  String?  @db.Uuid
  production_batch_output_id String?  @db.Uuid
  quantity                   Decimal  @db.Decimal(14, 3)
  reason_code                String   @db.VarChar(64)
  reason                     String   @db.VarChar(1000)
  recorded_by_id             String   @db.Uuid
  recorded_at                DateTime @db.Timestamp(6)

  production_batch                      ProductionBatch        @relation("ProductionBatchLossProductionBatch", fields: [production_batch_id], references: [production_batch_id], onDelete: NoAction, onUpdate: NoAction)
  production_batch_input                ProductionBatchInput?  @relation("ProductionBatchLossProductionBatchInput", fields: [production_batch_input_id], references: [production_batch_input_id], onDelete: NoAction, onUpdate: NoAction)
  production_batch_output               ProductionBatchOutput? @relation("ProductionBatchLossProductionBatchOutput", fields: [production_batch_output_id], references: [production_batch_output_id], onDelete: NoAction, onUpdate: NoAction)
  recorded_by                           User                   @relation("ProductionBatchLossRecordedBy", fields: [recorded_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  stock_movements_production_batch_loss StockMovement[]        @relation("StockMovementProductionBatchLoss")

  @@map("production_batch_losses")
}

/// Append-only status and QC history.
model ProductionBatchEvent {
  production_batch_event_id String              @id @default(uuid()) @db.Uuid
  production_batch_id       String              @db.Uuid
  event_type                ProductionEventType
  from_status               ProductionStatus?
  to_status                 ProductionStatus
  performed_by_id           String              @db.Uuid
  reason                    String?             @db.VarChar(1000)
  created_at                DateTime            @default(now()) @db.Timestamp(6)

  production_batch ProductionBatch @relation("ProductionBatchEventProductionBatch", fields: [production_batch_id], references: [production_batch_id], onDelete: NoAction, onUpdate: NoAction)
  performed_by     User            @relation("ProductionBatchEventPerformedBy", fields: [performed_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("production_batch_events")
}

/// Created when an order is confirmed. Ticket contents come from order_items and order_item_modifiers.
model KitchenTicket {
  kitchen_ticket_id      String              @id @default(uuid()) @db.Uuid
  order_id               String              @unique @db.Uuid
  ticket_number          String              @unique @db.VarChar(64)
  status                 KitchenTicketStatus @default(QUEUED)
  preparer_id            String?             @db.Uuid
  checker_id             String?             @db.Uuid
  created_by_id          String              @db.Uuid
  acknowledged_at        DateTime?           @db.Timestamp(6)
  preparation_started_at DateTime?           @db.Timestamp(6)
  ready_at               DateTime?           @db.Timestamp(6)
  handed_over_at         DateTime?           @db.Timestamp(6)
  cancelled_at           DateTime?           @db.Timestamp(6)
  notes                  String?             @db.VarChar(2000)
  created_at             DateTime            @default(now()) @db.Timestamp(6)
  modified_at            DateTime            @default(now()) @db.Timestamp(6)

  order                                Order                @relation("KitchenTicketOrder", fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)
  preparer                             User?                @relation("KitchenTicketPreparer", fields: [preparer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  checker                              User?                @relation("KitchenTicketChecker", fields: [checker_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  created_by                           User                 @relation("KitchenTicketCreatedBy", fields: [created_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  kitchen_ticket_events_kitchen_ticket KitchenTicketEvent[] @relation("KitchenTicketEventKitchenTicket")

  @@index([status, created_at])
  @@map("kitchen_tickets")
}

/// Append-only kitchen history. QC failures record the issue; repeated checks and rework create additional events.
model KitchenTicketEvent {
  kitchen_ticket_event_id String               @id @default(uuid()) @db.Uuid
  kitchen_ticket_id       String               @db.Uuid
  event_type              KitchenEventType
  from_status             KitchenTicketStatus?
  to_status               KitchenTicketStatus
  performed_by_id         String               @db.Uuid
  reason                  String?              @db.VarChar(1000)
  details                 Json?                @db.JsonB
  created_at              DateTime             @default(now()) @db.Timestamp(6)

  kitchen_ticket KitchenTicket @relation("KitchenTicketEventKitchenTicket", fields: [kitchen_ticket_id], references: [kitchen_ticket_id], onDelete: NoAction, onUpdate: NoAction)
  performed_by   User          @relation("KitchenTicketEventPerformedBy", fields: [performed_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([kitchen_ticket_id, created_at])
  @@map("kitchen_ticket_events")
}

/// Append-only order history. Before/after snapshots preserve item, modifier and quantity changes, including removed lines.
model OrderEvent {
  order_event_id  String         @id @default(uuid()) @db.Uuid
  order_id        String         @db.Uuid
  event_type      OrderEventType
  performed_by_id String         @db.Uuid
  reason          String?        @db.VarChar(1000)
  before_data     Json?          @db.JsonB
  after_data      Json?          @db.JsonB
  created_at      DateTime       @default(now()) @db.Timestamp(6)

  order        Order @relation("OrderEventOrder", fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)
  performed_by User  @relation("OrderEventPerformedBy", fields: [performed_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([order_id, created_at])
  @@map("order_events")
}

/// Append-only audit history. Actor may be null for system or unauthenticated actions. Exclude passwords, tokens and restricted recipe instructions from snapshots.
model AuditLog {
  audit_log_id String       @id @default(uuid()) @db.Uuid
  actor_id     String?      @db.Uuid
  /// RECIPE_UPDATED, BRAND_ASSIGNMENT_ADDED, etc.
  action       String       @db.VarChar(100)
  /// recipes, users, stock_adjustments, etc.
  entity_type  String       @db.VarChar(64)
  entity_id    String?      @db.Uuid
  outcome      AuditOutcome
  reason       String?      @db.VarChar(1000)
  before_data  Json?        @db.JsonB
  after_data   Json?        @db.JsonB
  request_id   String?      @db.VarChar(128)
  created_at   DateTime     @default(now()) @db.Timestamp(6)

  actor User? @relation("AuditLogActor", fields: [actor_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entity_type, entity_id, created_at])
  @@index([actor_id, created_at])
  @@map("audit_logs")
}
