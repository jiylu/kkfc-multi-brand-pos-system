// Multi-brand POS operational schema
// Bounded string lengths follow docs/schema-limits.md.
// Independent UUID primary keys are generated by Prisma with @default(uuid()).
// Shared primary/foreign keys and composite keys reuse the referenced IDs. All refs are inline.
// modified_at requires application or trigger updates; its default only initializes it.
// Proposal only. Stock ledger and lot caches update atomically; item totals and reservations are derived.
// All foreign keys use NO ACTION; deactivate used catalog records and retain operational history.
// Row CHECK constraints are executable. Cross-row and transition rules are documented in state-diagrams/README.md.
// This is a proposal, not an applied database migration.

Enum audit_outcomes {
  SUCCESS
  DENIED
  FAILED
}

Enum modifier_component_actions {
  ADD
  REMOVE
}

Enum order_event_types {
  CREATED
  CONFIRMED
  ITEM_ADDED
  ITEM_UPDATED
  ITEM_REMOVED
  MODIFIER_CHANGED
  STATUS_CHANGED
  CANCELLED
  ACKNOWLEDGED
  PREPARATION_STARTED
  SUBMITTED_FOR_QC
  QC_FAILED
  REWORK_STARTED
  QC_PASSED
  READY
  HANDED_OVER
  ASSIGNMENT_CHANGED
  CONSUMPTION_RECLASSIFIED
}

Enum order_channels {
  DINE_IN
  TAKEAWAY
  GRABFOOD
  FOODPANDA
}

Enum order_statuses {
  DRAFT
  CONFIRMED
  ACKNOWLEDGED
  PREPARING
  REWORKING
  CHECKING
  READY
  COMPLETED
  CANCELLED
}

Enum user_roles {
  OWNER
  KITCHEN_HEAD
  RECEIVING_STAFF
  KITCHEN_PREPARER
  ORDER_STAFF
}

Enum stock_buckets {
  USABLE
  HELD
  IN_PREPARATION
}

Enum reservation_statuses {
  ACTIVE
  CONSUMED
  RELEASED
}

Enum recipe_types {
  MENU_ASSEMBLY
  PRODUCTION
}

Enum inventory_types {
  RAW
  PREPPED
  PACKAGING
}

Enum receipt_statuses {
  DRAFT
  ACCEPTED
  CANCELLED
}

Enum count_statuses {
  DRAFT
  SUBMITTED
  REVIEWED
  CANCELLED
}

Enum adjustment_statuses {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

Enum stock_movement_types {
  RECEIPT
  BUCKET_TRANSFER
  ORDER_CONSUMPTION
  PRODUCTION_ISSUE
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  PRODUCTION_RETURN
  WASTE
  ADJUSTMENT
  REVERSAL
}

Enum production_statuses {
  DRAFT
  APPROVED
  IN_PROGRESS
  AWAITING_QC
  HELD
  REWORKING
  ACCEPTED
  REJECTED
  CANCELLED
}

Enum production_event_types {
  APPROVED
  STARTED
  SUBMITTED_FOR_QC
  QC_PASSED
  QC_FAILED
  HELD
  REWORK_STARTED
  ACCEPTED
  REJECTED
  CANCELLED
}

Table users {
  user_id uuid [pk]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  password_hash varchar(255) [not null]
  role user_roles [not null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
}

Table user_brand_assignments {
  user_id uuid [not null, ref: > users.user_id]
  brand_id uuid [not null, ref: > brands.brand_id]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  indexes {
    (user_id, brand_id) [pk]
  }
}

Table brands {
  brand_id uuid [pk]
  name varchar(150) [not null]
  logo_url varchar(2048)
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  is_active boolean [not null, default: true]
}

Table orders {
  request_key varchar(128) [not null, unique]
  ticket_number varchar(64) [unique]
  preparer_id uuid [ref: > users.user_id]
  checker_id uuid [ref: > users.user_id]
  acknowledged_at timestamp
  preparation_started_at timestamp
  ready_at timestamp
  order_id uuid [pk]
  brand_id uuid [not null, ref: > brands.brand_id]
  created_by_id uuid [not null, ref: > users.user_id]
  order_channel order_channels [not null]
  merchant_store_reference varchar(255) [note: 'Stable platform store ID or configured store code; null for internal orders']
  external_order_reference varchar(255) [note: 'Platform order ID; null for internal orders']
  table_reference varchar(50)
  status order_statuses [not null, default: 'DRAFT']
  notes varchar(2000)
  cancelled_by_id uuid [ref: > users.user_id]
  cancellation_reason varchar(1000)
  cancelled_at timestamp
  confirmed_at timestamp
  completed_at timestamp
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  indexes {
    (order_channel, merchant_store_reference, external_order_reference) [unique]
    (brand_id, created_at)
    (status, created_at)
  }
  checks {
    `(order_channel IN ('GRABFOOD','FOODPANDA') AND (status = 'DRAFT' OR (nullif(btrim(merchant_store_reference), '') IS NOT NULL AND nullif(btrim(external_order_reference), '') IS NOT NULL))) OR (order_channel NOT IN ('GRABFOOD','FOODPANDA') AND merchant_store_reference IS NULL AND external_order_reference IS NULL)` [name: 'orders_external_identity']
    `status IN ('DRAFT','CANCELLED') OR (confirmed_at IS NOT NULL AND ticket_number IS NOT NULL)` [name: 'orders_confirmed_ticket']
    `status <> 'CANCELLED' OR (cancelled_by_id IS NOT NULL AND cancelled_at IS NOT NULL AND nullif(btrim(cancellation_reason), '') IS NOT NULL)` [name: 'orders_cancel_metadata']
    `status <> 'READY' OR (ready_at IS NOT NULL AND checker_id IS NOT NULL)` [name: 'orders_ready_metadata']
    `status <> 'COMPLETED' OR (completed_at IS NOT NULL AND ready_at IS NOT NULL)` [name: 'orders_completed_metadata']
    `length(btrim(request_key)) > 0` [name: 'orders_request_key']
  }
}

Table order_items {
  prepared_quantity integer [note: 'Servings committed at preparation start; immutable thereafter, independent of later cancellations']
  cancelled_quantity integer [not null, default: 0, note: 'Cumulative cancelled servings; between zero and original quantity. Original quantity and posted components remain immutable.']
  recipe_id uuid [ref: > recipes.recipe_id]
  cancelled_by_id uuid [ref: > users.user_id]
  cancelled_at timestamp
  cancellation_reason varchar(1000)
  preparation_started_at timestamp
  order_item_id uuid [pk]
  order_id uuid [not null, ref: > orders.order_id]
  menu_item_id uuid [not null, ref: > menu_items.menu_item_id]
  item_name varchar(150) [not null]
  quantity integer [not null]
  unit_price decimal(12,2) [not null]
  notes varchar(2000)
  checks {
    `(preparation_started_at IS NULL AND prepared_quantity IS NULL) OR (preparation_started_at IS NOT NULL AND prepared_quantity IS NOT NULL AND prepared_quantity > 0 AND prepared_quantity <= quantity)` [name: 'order_items_preparation_snapshot']
    `quantity > 0 AND cancelled_quantity BETWEEN 0 AND quantity` [name: 'order_items_quantities']
    `unit_price >= 0` [name: 'order_items_price']
    `cancelled_quantity = 0 OR (cancelled_by_id IS NOT NULL AND cancelled_at IS NOT NULL AND nullif(btrim(cancellation_reason), '') IS NOT NULL)` [name: 'order_items_cancel_metadata']
  }
}

Table order_item_modifiers {
  order_item_modifier_id uuid [pk]
  order_item_id uuid [not null, ref: > order_items.order_item_id]
  modifier_id uuid [not null, ref: > modifiers.modifier_id]
  modifier_name varchar(150) [not null]
  additional_price decimal(12,2) [not null, default: 0]
  indexes {
    (order_item_id, modifier_id) [unique]
  }
  checks {
    `additional_price >= 0` [name: 'order_item_modifiers_price']
  }
}

Table menu_items {
  menu_item_id uuid [pk]
  brand_id uuid [not null, ref: > brands.brand_id]
  recipe_id uuid [ref: > recipes.recipe_id]
  code varchar(64) [unique, not null]
  name varchar(150) [not null]
  description varchar(2000)
  serving_description varchar(255)
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
}

Table modifiers {
  modifier_id uuid [pk]
  code varchar(64) [not null, unique]
  name varchar(150) [not null]
  description varchar(2000)
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
}

Table menu_item_modifiers {
  menu_item_id uuid [not null, ref: > menu_items.menu_item_id]
  modifier_id uuid [not null, ref: > modifiers.modifier_id]
  additional_price decimal(12,2) [not null, default: 0]
  indexes {
    (menu_item_id, modifier_id) [pk]
  }
  checks {
    `additional_price >= 0` [name: 'menu_item_modifiers_price']
  }
}

Table modifier_components {
  modifier_component_id uuid [pk]
  menu_item_id uuid [not null, ref: > menu_items.menu_item_id]
  modifier_id uuid [not null, ref: > modifiers.modifier_id]
  inventory_item_id uuid [not null, ref: > inventory_items.inventory_item_id]
  action modifier_component_actions [not null]
  quantity decimal(14,3) [not null, note: 'Positive quantity per menu serving, in the inventory item base unit']
  indexes {
    (menu_item_id, modifier_id, inventory_item_id, action) [unique]
  }
  checks {
    `quantity > 0` [name: 'modifier_components_quantity']
  }
}

Table inventory_items {
  requires_use_by boolean [not null, default: true, note: 'Explicit item policy; configure false for nonperishable items']
  inventory_item_id uuid [pk]
  code varchar(64) [not null, unique]
  name varchar(150) [not null]
  type inventory_types [not null]
  base_unit varchar(16) [not null, note: 'g, ml, pc']
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  checks {
    `base_unit IN ('g','ml','pc')` [name: 'inventory_items_base_unit']
  }
}

Table goods_receipts {
  cancelled_by_id uuid [ref: > users.user_id]
  cancelled_at timestamp
  cancellation_reason varchar(1000)
  request_key varchar(128) [not null, unique]
  goods_receipt_id uuid [pk]
  receipt_number varchar(64) [not null, unique]
  supplier_name varchar(200) [not null]
  supplier_document_reference varchar(255)
  status receipt_statuses [not null, default: 'DRAFT']
  received_at timestamp [not null]
  created_by_id uuid [not null, ref: > users.user_id]
  accepted_by_id uuid [ref: > users.user_id]
  accepted_at timestamp
  notes varchar(2000)
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  checks {
    `status <> 'ACCEPTED' OR (accepted_by_id IS NOT NULL AND accepted_at IS NOT NULL)` [name: 'goods_receipts_accept_metadata']
    `status <> 'CANCELLED' OR (cancelled_by_id IS NOT NULL AND cancelled_at IS NOT NULL AND nullif(btrim(cancellation_reason), '') IS NOT NULL)` [name: 'goods_receipts_cancel_metadata']
    `length(btrim(request_key)) > 0` [name: 'goods_receipts_request_key']
  }
}

Table goods_receipt_items {
  entered_unit varchar(16) [not null]
  base_units_per_entered_unit decimal(18,6) [not null, note: 'Historical factor snapshot; quantities below are canonical base-unit quantities']
  goods_receipt_item_id uuid [pk]
  goods_receipt_id uuid [not null, ref: > goods_receipts.goods_receipt_id]
  inventory_item_id uuid [not null, ref: > inventory_items.inventory_item_id]
  supplier_batch_reference varchar(255)
  use_by_at timestamp
  delivered_quantity decimal(14,3) [not null]
  accepted_quantity decimal(14,3) [not null, default: 0]
  rejected_quantity decimal(14,3) [not null, default: 0]
  rejection_reason varchar(1000)
  notes varchar(2000)
  Note: 'Use separate lines for different supplier batches or expiry dates, even for the same inventory item.'
  checks {
    `base_units_per_entered_unit > 0 AND length(btrim(entered_unit)) > 0` [name: 'goods_receipt_items_factor']
    `delivered_quantity > 0 AND accepted_quantity >= 0 AND rejected_quantity >= 0 AND accepted_quantity + rejected_quantity = delivered_quantity` [name: 'goods_receipt_items_quantities']
    `rejected_quantity = 0 OR nullif(btrim(rejection_reason), '') IS NOT NULL` [name: 'goods_receipt_items_reject_reason']
  }
}

Table stock_lots {
  active_stock_count_id uuid [ref: > stock_counts.stock_count_id]
  stock_lot_id uuid [pk]
  inventory_item_id uuid [not null, ref: > inventory_items.inventory_item_id]
  lot_code varchar(64) [not null, unique]
  goods_receipt_item_id uuid [ref: > goods_receipt_items.goods_receipt_item_id]
  prepared_at timestamp
  use_by_at timestamp
  quantity_usable decimal(14,3) [not null, default: 0]
  quantity_held decimal(14,3) [not null, default: 0]
  quantity_in_preparation decimal(14,3) [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  indexes {
    (inventory_item_id, use_by_at)
  }
  Note: 'Batch-level quantity caches. Reserved quantity is the sum of quantity minus released_quantity for ACTIVE reservations. Expired lots are excluded from availability.'
  checks {
    `quantity_usable >= 0 AND quantity_held >= 0 AND quantity_in_preparation >= 0` [name: 'stock_lots_quantities']
    `prepared_at IS NULL OR use_by_at IS NULL OR use_by_at > prepared_at` [name: 'stock_lots_dates']
  }
}

Table stock_reservations {
  released_quantity decimal(14,3) [not null, default: 0]
  order_item_component_id uuid [not null, ref: > order_item_components.order_item_component_id]
  stock_reservation_id uuid [pk]
  stock_lot_id uuid [not null, ref: > stock_lots.stock_lot_id]
  quantity decimal(14,3) [not null]
  status reservation_statuses [not null, default: 'ACTIVE']
  reservation_key varchar(255) [not null, unique]
  created_by_id uuid [not null, ref: > users.user_id]
  created_at timestamp [not null, default: `now()`]
  consumed_at timestamp
  released_at timestamp
  indexes {
    (order_item_component_id, status)
    (stock_lot_id, status)
  }
  Note: 'One allocation per row. Reserving reduces availability without reducing physical stock.'
  checks {
    `quantity > 0 AND released_quantity BETWEEN 0 AND quantity` [name: 'stock_reservations_quantities']
    `(status = 'ACTIVE' AND released_quantity < quantity AND consumed_at IS NULL) OR (status = 'CONSUMED' AND released_quantity < quantity AND consumed_at IS NOT NULL) OR (status = 'RELEASED' AND released_quantity = quantity AND consumed_at IS NULL)` [name: 'stock_reservations_status_quantities']
    `released_quantity = 0 OR released_at IS NOT NULL` [name: 'stock_reservations_release_metadata']
  }
}

Table stock_counts {
  cancelled_by_id uuid [ref: > users.user_id]
  cancelled_at timestamp
  cancellation_reason varchar(1000)
  stock_count_id uuid [pk]
  status count_statuses [not null, default: 'DRAFT']
  cutoff_at timestamp [not null]
  created_by_id uuid [not null, ref: > users.user_id]
  reviewed_by_id uuid [ref: > users.user_id]
  submitted_at timestamp
  reviewed_at timestamp
  notes varchar(2000)
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  checks {
    `status NOT IN ('SUBMITTED','REVIEWED') OR submitted_at IS NOT NULL` [name: 'stock_counts_submit_metadata']
    `status <> 'REVIEWED' OR (reviewed_by_id IS NOT NULL AND reviewed_at IS NOT NULL)` [name: 'stock_counts_review_metadata']
    `status <> 'CANCELLED' OR (cancelled_by_id IS NOT NULL AND cancelled_at IS NOT NULL AND nullif(btrim(cancellation_reason), '') IS NOT NULL)` [name: 'stock_counts_cancel_metadata']
  }
}

Table stock_count_items {
  entered_unit varchar(16) [not null]
  base_units_per_entered_unit decimal(18,6) [not null, note: 'Historical factor snapshot; quantities below are canonical base-unit quantities']
  stock_count_item_id uuid [pk]
  stock_count_id uuid [not null, ref: > stock_counts.stock_count_id]
  stock_lot_id uuid [not null, ref: > stock_lots.stock_lot_id]
  bucket stock_buckets [not null]
  expected_quantity decimal(14,3) [not null]
  counted_quantity decimal(14,3)
  counted_by_id uuid [ref: > users.user_id]
  counted_at timestamp
  notes varchar(2000)
  indexes {
    (stock_count_id, stock_lot_id, bucket) [unique]
  }
  Note: 'Count by lot and stock bucket. Expected quantity is captured at the cutoff; counting does not post stock.'
  checks {
    `expected_quantity >= 0 AND (counted_quantity IS NULL OR counted_quantity >= 0)` [name: 'stock_count_items_quantities']
    `base_units_per_entered_unit > 0 AND length(btrim(entered_unit)) > 0` [name: 'stock_count_items_factor']
    `(counted_quantity IS NULL AND counted_by_id IS NULL AND counted_at IS NULL) OR (counted_quantity IS NOT NULL AND counted_by_id IS NOT NULL AND counted_at IS NOT NULL)` [name: 'stock_count_items_count_metadata']
  }
}

Table stock_adjustments {
  request_key varchar(128) [not null, unique]
  stock_adjustment_id uuid [pk]
  stock_count_id uuid [unique, ref: > stock_counts.stock_count_id]
  status adjustment_statuses [not null, default: 'DRAFT']
  reason_code varchar(64) [not null]
  reason varchar(1000) [not null]
  requested_by_id uuid [not null, ref: > users.user_id]
  reviewed_by_id uuid [ref: > users.user_id]
  reviewed_at timestamp
  review_notes varchar(2000)
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  checks {
    `length(btrim(reason_code)) > 0 AND length(btrim(reason)) > 0` [name: 'stock_adjustments_reason']
    `status NOT IN ('APPROVED','REJECTED') OR (reviewed_by_id IS NOT NULL AND reviewed_at IS NOT NULL)` [name: 'stock_adjustments_review_metadata']
    `length(btrim(request_key)) > 0` [name: 'stock_adjustments_request_key']
  }
}

Table stock_adjustment_items {
  stock_count_item_id uuid [unique, ref: > stock_count_items.stock_count_item_id]
  stock_adjustment_item_id uuid [pk]
  stock_adjustment_id uuid [not null, ref: > stock_adjustments.stock_adjustment_id]
  stock_lot_id uuid [not null, ref: > stock_lots.stock_lot_id]
  bucket stock_buckets [not null]
  quantity_change decimal(14,3) [not null]
  notes varchar(2000)
  indexes {
    (stock_adjustment_id, stock_lot_id, bucket) [unique]
  }
  checks {
    `quantity_change <> 0` [name: 'stock_adjustment_items_quantity']
  }
}

Table stock_movements {
  order_item_component_id uuid [ref: > order_item_components.order_item_component_id]
  is_measured boolean [note: 'For order/process consumption: true measured, false standard or declared estimate; null for other movement types']
  stock_movement_id uuid [pk]
  stock_lot_id uuid [not null, ref: > stock_lots.stock_lot_id]
  type stock_movement_types [not null]
  bucket stock_buckets [not null]
  quantity_change decimal(14,3) [not null, note: 'Signed quantity in the inventory item base unit']
  goods_receipt_item_id uuid [ref: > goods_receipt_items.goods_receipt_item_id]
  stock_adjustment_item_id uuid [ref: > stock_adjustment_items.stock_adjustment_item_id]
  stock_reservation_id uuid [ref: > stock_reservations.stock_reservation_id]
  transfer_key varchar(255) [note: 'Groups paired movements between stock buckets']
  posting_key varchar(255) [not null, unique]
  reverses_movement_id uuid [ref: > stock_movements.stock_movement_id]
  created_by_id uuid [not null, ref: > users.user_id]
  reason varchar(1000)
  occurred_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]
  production_batch_input_id uuid [ref: > production_batch_inputs.production_batch_input_id]
  production_batch_output_id uuid [ref: > production_batch_outputs.production_batch_output_id]
  production_batch_return_id uuid [ref: > production_batch_returns.production_batch_return_id]
  production_batch_loss_id uuid [ref: > production_batch_losses.production_batch_loss_id]
  indexes {
    (stock_lot_id, bucket, occurred_at)
    transfer_key
  }
  Note: 'Immutable ledger. Inventory item is identified through the stock lot.'
  checks {
    `quantity_change <> 0 AND length(btrim(posting_key)) > 0` [name: 'stock_movements_quantity_key']
    `num_nonnulls(goods_receipt_item_id,stock_adjustment_item_id,order_item_component_id,production_batch_input_id,production_batch_output_id,production_batch_return_id,production_batch_loss_id,reverses_movement_id) = 1` [name: 'stock_movements_one_source']
    `CASE type WHEN 'RECEIPT' THEN goods_receipt_item_id IS NOT NULL WHEN 'ORDER_CONSUMPTION' THEN order_item_component_id IS NOT NULL WHEN 'PRODUCTION_ISSUE' THEN production_batch_input_id IS NOT NULL WHEN 'PRODUCTION_CONSUMPTION' THEN production_batch_input_id IS NOT NULL WHEN 'PRODUCTION_OUTPUT' THEN production_batch_output_id IS NOT NULL WHEN 'BUCKET_TRANSFER' THEN production_batch_output_id IS NOT NULL WHEN 'PRODUCTION_RETURN' THEN production_batch_return_id IS NOT NULL WHEN 'WASTE' THEN stock_adjustment_item_id IS NOT NULL OR production_batch_loss_id IS NOT NULL WHEN 'ADJUSTMENT' THEN stock_adjustment_item_id IS NOT NULL WHEN 'REVERSAL' THEN reverses_movement_id IS NOT NULL AND nullif(btrim(reason), '') IS NOT NULL ELSE false END` [name: 'stock_movements_source_type']
    `CASE type WHEN 'RECEIPT' THEN bucket='USABLE' AND quantity_change>0 WHEN 'ORDER_CONSUMPTION' THEN bucket='USABLE' AND quantity_change<0 WHEN 'PRODUCTION_ISSUE' THEN (bucket='USABLE' AND quantity_change<0) OR (bucket='IN_PREPARATION' AND quantity_change>0) WHEN 'PRODUCTION_CONSUMPTION' THEN bucket='IN_PREPARATION' AND quantity_change<0 WHEN 'PRODUCTION_OUTPUT' THEN bucket='HELD' AND quantity_change>0 WHEN 'BUCKET_TRANSFER' THEN (bucket='HELD' AND quantity_change<0) OR (bucket='USABLE' AND quantity_change>0) WHEN 'PRODUCTION_RETURN' THEN (bucket='IN_PREPARATION' AND quantity_change<0) OR (bucket='USABLE' AND quantity_change>0) WHEN 'WASTE' THEN quantity_change<0 ELSE true END` [name: 'stock_movements_bucket_direction']
    `(type IN ('ORDER_CONSUMPTION','PRODUCTION_CONSUMPTION') AND is_measured IS NOT NULL) OR (type NOT IN ('ORDER_CONSUMPTION','PRODUCTION_CONSUMPTION') AND is_measured IS NULL)` [name: 'stock_movements_measurement_basis']
    `stock_reservation_id IS NULL OR type='ORDER_CONSUMPTION'` [name: 'stock_movements_reservation_source']
    `(type IN ('PRODUCTION_ISSUE','PRODUCTION_RETURN','BUCKET_TRANSFER') AND nullif(btrim(transfer_key), '') IS NOT NULL) OR (type NOT IN ('PRODUCTION_ISSUE','PRODUCTION_RETURN','BUCKET_TRANSFER') AND transfer_key IS NULL)` [name: 'stock_movements_transfer_shape']
  }
}

Table recipes {
  yield_basis varchar(1000) [note: 'Required production yield explanation; expected primary output per standard recipe batch, in its item base unit']
  recipe_id uuid [pk]
  code varchar(64) [not null]
  name varchar(150) [not null]
  type recipe_types [not null]
  output_inventory_item_id uuid [ref: > inventory_items.inventory_item_id]
  expected_output_quantity decimal(14,3)
  serving_description varchar(255)
  instructions varchar(10000)
  notes varchar(2000)
  version integer [not null, default: 1]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  indexes {
    (code, version) [unique]
  }
  Note: 'MENU_ASSEMBLY: components per serving. PRODUCTION: components per standard batch, with a primary output inventory item and expected yield. Once referenced by a confirmed order or approved batch, the version and its components are immutable; changes create a new version.'
  checks {
    `version > 0` [name: 'recipes_version']
    `(type = 'MENU_ASSEMBLY' AND output_inventory_item_id IS NULL AND expected_output_quantity IS NULL AND yield_basis IS NULL) OR (type = 'PRODUCTION' AND output_inventory_item_id IS NOT NULL AND expected_output_quantity IS NOT NULL AND expected_output_quantity > 0 AND nullif(btrim(yield_basis), '') IS NOT NULL)` [name: 'recipes_type_shape']
  }
}

Table recipe_components {
  recipe_component_id uuid [pk]
  recipe_id uuid [not null, ref: > recipes.recipe_id]
  inventory_item_id uuid [not null, ref: > inventory_items.inventory_item_id]
  quantity decimal(14,3) [not null]
  notes varchar(2000)
  indexes {
    (recipe_id, inventory_item_id) [unique]
  }
  Note: 'Quantity uses the ingredient inventory item base unit. Ingredients may be raw or prepared items.'
  checks {
    `quantity > 0` [name: 'recipe_components_quantity']
  }
}

Table production_batches {
  closed_by_id uuid [ref: > users.user_id]
  closure_reason varchar(1000)
  request_key varchar(128) [not null, unique]
  production_batch_id uuid [pk]
  batch_number varchar(64) [not null, unique]
  recipe_id uuid [not null, ref: > recipes.recipe_id]
  target_output_quantity decimal(14,3) [not null]
  status production_statuses [not null, default: 'DRAFT']
  created_by_id uuid [not null, ref: > users.user_id]
  preparer_id uuid [ref: > users.user_id]
  checker_id uuid [ref: > users.user_id]
  approved_by_id uuid [ref: > users.user_id]
  approved_at timestamp
  scheduled_at timestamp
  started_at timestamp
  completed_at timestamp
  notes varchar(2000)
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  Note: 'Recipe must be PRODUCTION. Target quantity uses the recipe output item base unit.'
  checks {
    `target_output_quantity > 0` [name: 'production_batches_target']
    `status IN ('DRAFT','CANCELLED') OR (approved_by_id IS NOT NULL AND approved_at IS NOT NULL)` [name: 'production_batches_approved_metadata']
    `status NOT IN ('IN_PROGRESS','AWAITING_QC','HELD','REWORKING','ACCEPTED','REJECTED') OR (started_at IS NOT NULL AND preparer_id IS NOT NULL)` [name: 'production_batches_started_metadata']
    `status NOT IN ('ACCEPTED','REJECTED','CANCELLED') OR (completed_at IS NOT NULL AND closed_by_id IS NOT NULL)` [name: 'production_batches_closed_metadata']
    `status NOT IN ('REJECTED','CANCELLED') OR nullif(btrim(closure_reason), '') IS NOT NULL` [name: 'production_batches_closure_reason']
    `length(btrim(request_key)) > 0` [name: 'production_batches_request_key']
  }
}

Table production_batch_inputs {
  request_key varchar(128) [not null, unique]
  production_batch_input_id uuid [pk]
  production_batch_id uuid [not null, ref: > production_batches.production_batch_id]
  stock_lot_id uuid [not null, ref: > stock_lots.stock_lot_id]
  issued_quantity decimal(14,3) [not null]
  issued_by_id uuid [not null, ref: > users.user_id]
  issued_at timestamp [not null]
  notes varchar(2000)
  Note: 'One actual issue per row. The source lot identifies the input item and unit. At settlement: issued = consumed + returned + input loss; all quantities use this input item unit.'
  checks {
    `issued_quantity > 0` [name: 'production_batch_inputs_quantity']
    `length(btrim(request_key)) > 0` [name: 'production_batch_inputs_request_key']
  }
}

Table production_batch_outputs {
  request_key varchar(128) [not null, unique]
  production_batch_output_id uuid [pk]
  production_batch_id uuid [not null, ref: > production_batches.production_batch_id]
  stock_lot_id uuid [not null, unique, ref: - stock_lots.stock_lot_id]
  produced_quantity decimal(14,3) [not null]
  accepted_quantity decimal(14,3) [not null, default: 0]
  recorded_by_id uuid [not null, ref: > users.user_id]
  recorded_at timestamp [not null]
  accepted_by_id uuid [ref: > users.user_id]
  accepted_at timestamp
  notes varchar(2000)
  Note: 'Output initially enters HELD stock. Accepted quantities transfer to USABLE. Prepared time and use-by are stored on the output lot.'
  checks {
    `produced_quantity > 0 AND accepted_quantity BETWEEN 0 AND produced_quantity` [name: 'production_batch_outputs_quantities']
    `accepted_quantity = 0 OR (accepted_by_id IS NOT NULL AND accepted_at IS NOT NULL)` [name: 'production_batch_outputs_accept_metadata']
    `length(btrim(request_key)) > 0` [name: 'production_batch_outputs_request_key']
  }
}

Table production_batch_returns {
  request_key varchar(128) [not null, unique]
  production_batch_return_id uuid [pk]
  production_batch_input_id uuid [not null, ref: > production_batch_inputs.production_batch_input_id]
  quantity decimal(14,3) [not null]
  reason varchar(1000) [not null]
  returned_by_id uuid [not null, ref: > users.user_id]
  returned_at timestamp [not null]
  Note: 'Recoverable unused input returns to its source lot. Transformed leftovers require a separate output item.'
  checks {
    `quantity > 0 AND length(btrim(reason)) > 0` [name: 'production_batch_returns_quantity']
    `length(btrim(request_key)) > 0` [name: 'production_batch_returns_request_key']
  }
}

Table production_batch_losses {
  request_key varchar(128) [not null, unique]
  production_batch_loss_id uuid [pk]
  production_batch_id uuid [not null, ref: > production_batches.production_batch_id]
  production_batch_input_id uuid [ref: > production_batch_inputs.production_batch_input_id]
  production_batch_output_id uuid [ref: > production_batch_outputs.production_batch_output_id]
  quantity decimal(14,3) [not null]
  reason_code varchar(64) [not null]
  reason varchar(1000) [not null]
  recorded_by_id uuid [not null, ref: > users.user_id]
  recorded_at timestamp [not null]
  Note: 'Reference exactly one input or output belonging to this batch. Record only additional physical loss here, never stock already consumed by a sale. Quantity uses that item base unit.'
  checks {
    `quantity > 0 AND length(btrim(reason)) > 0 AND length(btrim(reason_code)) > 0` [name: 'production_batch_losses_quantity']
    `num_nonnulls(production_batch_input_id, production_batch_output_id) = 1` [name: 'production_batch_losses_one_source']
    `length(btrim(request_key)) > 0` [name: 'production_batch_losses_request_key']
  }
}

Table production_batch_events {
  production_batch_event_id uuid [pk]
  production_batch_id uuid [not null, ref: > production_batches.production_batch_id]
  event_type production_event_types [not null]
  from_status production_statuses
  to_status production_statuses [not null]
  performed_by_id uuid [not null, ref: > users.user_id]
  reason varchar(1000)
  created_at timestamp [not null, default: `now()`]
  Note: 'Append-only status and QC history.'
}

Table order_events {
  order_item_id uuid [ref: > order_items.order_item_id]
  stock_movement_id uuid [ref: > stock_movements.stock_movement_id]
  quantity decimal(14,3) [note: 'Required positive quantity for CONSUMPTION_RECLASSIFIED; uses the referenced movement item unit, with no new deduction']
  from_status order_statuses
  to_status order_statuses
  order_event_id uuid [pk]
  order_id uuid [not null, ref: > orders.order_id]
  event_type order_event_types [not null]
  performed_by_id uuid [not null, ref: > users.user_id]
  reason varchar(1000)
  before_data jsonb
  after_data jsonb
  created_at timestamp [not null, default: `now()`]
  indexes {
    (order_id, created_at)
  }
  Note: 'Append-only order history. Before/after snapshots preserve item, modifier and quantity changes, including cancelled lines. Also stores kitchen QC and consumed-stock waste classification; the latter has no new net stock movement.'
  checks {
    `(event_type = 'CONSUMPTION_RECLASSIFIED' AND stock_movement_id IS NOT NULL AND order_item_id IS NOT NULL AND quantity IS NOT NULL AND quantity > 0 AND nullif(btrim(reason), '') IS NOT NULL) OR (event_type <> 'CONSUMPTION_RECLASSIFIED' AND stock_movement_id IS NULL AND quantity IS NULL)` [name: 'order_events_reclassification']
    `(from_status IS NULL AND to_status IS NULL) OR to_status IS NOT NULL` [name: 'order_events_status_pair']
  }
}

Table audit_logs {
  audit_log_id uuid [pk]
  actor_id uuid [ref: > users.user_id]
  action varchar(100) [not null, note: 'RECIPE_UPDATED, BRAND_ASSIGNMENT_ADDED, etc.']
  entity_type varchar(64) [not null, note: 'recipes, users, stock_adjustments, etc.']
  entity_id uuid
  outcome audit_outcomes [not null]
  reason varchar(1000)
  before_data jsonb
  after_data jsonb
  request_id varchar(128)
  created_at timestamp [not null, default: `now()`]
  indexes {
    (entity_type, entity_id, created_at)
    (actor_id, created_at)
  }
  Note: 'Append-only audit history. Actor may be null for system or unauthenticated actions. Exclude passwords, tokens and restricted recipe instructions from snapshots.'
}

Table menu_item_channels {
  menu_item_id uuid [not null, ref: > menu_items.menu_item_id]
  order_channel order_channels [not null]
  price decimal(12,2) [not null]
  is_available boolean [not null, default: true]
  indexes {
    (menu_item_id, order_channel) [pk]
  }
  Note: 'Only configured and available channel entries are sellable. Order lines snapshot the selected price.'
  checks {
    `price >= 0` [name: 'menu_item_channels_price']
  }
}

Table inventory_item_units {
  inventory_item_id uuid [not null, ref: > inventory_items.inventory_item_id]
  unit varchar(16) [not null]
  base_units_per_unit decimal(18,6) [not null]
  indexes {
    (inventory_item_id, unit) [pk]
  }
  Note: 'Positive item-specific factor to its canonical base unit. Include base unit with factor 1. Fixed pack weights only; variable weights must be measured. Freeze base unit after use.'
  checks {
    `base_units_per_unit > 0 AND length(btrim(unit)) > 0` [name: 'inventory_item_units_factor']
  }
}

Table order_item_components {
  order_item_component_id uuid [pk]
  order_item_id uuid [not null, ref: > order_items.order_item_id]
  inventory_item_id uuid [not null, ref: > inventory_items.inventory_item_id]
  quantity_per_serving decimal(14,3) [not null, note: 'Immutable final canonical component quantity for one serving after modifiers; multiply by original or remaining line quantity']
  indexes {
    (order_item_id, inventory_item_id) [unique]
  }
  Note: 'Immutable applied BOM snapshot at confirmation. Only positive net per-serving components stored. Reservations must use lots of this same item. Confirmed configuration amendments cancel affected quantities on retained old lines and create replacement lines. Preparation-start consumption is never reassigned or deducted again.'
  checks {
    `quantity_per_serving > 0` [name: 'order_item_components_quantity']
  }
}
