# Use localhost for a local server, or db inside Docker Compose.
# DATABASE_URL takes precedence over the existing DB_* variables.
DATABASE_URL=postgresql://pos:change-me@localhost:5432/pos

AWS_REGION=ap-southeast-1
S3_BUCKET=kkfc-db-file-storage
# HTTPS distribution origin or custom domain, with no object path.
S3_PUBLIC_BASE_URL=
# CloudFront public key ID, not the distribution or IAM access key ID.
CLOUDFRONT_KEY_PAIR_ID=
# Absolute path to the signing private PEM file outside the repository.
CLOUDFRONT_PRIVATE_KEY_FILE=
# Alternative to the file: PEM content with literal \n or actual newlines.
CLOUDFRONT_PRIVATE_KEY=
